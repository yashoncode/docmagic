# Copy to .streamlit/secrets.toml (gitignored) for local runs, or paste into
# Streamlit Community Cloud → Manage app → Secrets. This is TOML, so quote values.
# The app reads these via st.secrets and as environment variables, so you can use
# this instead of a .env file.

LLM_API_KEY = "nvapi-xxxx"
LLM_BASE_URL = "https://integrate.api.nvidia.com/v1"
LLM_MODEL = "nvidia/nemotron-3-super-120b-a12b"

EMBED_API_KEY = "nvapi-xxxx"
EMBED_BASE_URL = "https://integrate.api.nvidia.com/v1"
EMBED_MODEL = "nvidia/nemotron-3-embed-1b"

# optional — enables the "Search the web" toggle (free key at tavily.com)
TAVILY_API_KEY = "tvly-xxxx"
