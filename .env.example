# Get a free key at https://build.nvidia.com (any model page -> Get API Key)
LLM_API_KEY=nvapi-xxxx
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# embeddings (defaults to LLM_API_KEY if unset; own endpoint so a non-NIM LLM works)
EMBED_API_KEY=nvapi-xxxx
EMBED_BASE_URL=https://integrate.api.nvidia.com/v1
EMBED_MODEL=nvidia/nemotron-3-embed-1b
# web search (optional; free key at tavily.com) — enables the "Search the web" toggle
TAVILY_API_KEY=tvly-xxxx
