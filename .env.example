# Get a free key at https://build.nvidia.com (any model page -> Get API Key)
LLM_API_KEY=nvapi-xxxx
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# "auto" lets a router gateway pick; or name a model id explicitly.
LLM_MODEL=auto
# Embeddings default to LLM_API_KEY if unset. A separate endpoint supports non-NIM chat models.
EMBED_API_KEY=nvapi-xxxx
EMBED_BASE_URL=https://integrate.api.nvidia.com/v1
EMBED_MODEL=nvidia/nemotron-3-embed-1b
# Vision model that reads scanned/image-only PDFs (runs on LLM_API_KEY/LLM_BASE_URL).
OCR_MODEL=meta/llama-4-scout-17b-16e-instruct
# Required: pgvector chunks and extracted spreadsheet tables.
POSTGRES_URL=postgresql+psycopg://user:pass@host:5432/postgres
# Optional web search key.
TAVILY_API_KEY=tvly-xxxx
# Frontend origin for credentialed CORS. Set COOKIE_CROSS_SITE=1 for a separate deployed site.
WEB_ORIGIN=http://localhost:3000
COOKIE_CROSS_SITE=
# --- Sign-in and token credits ---
# Google OAuth *Web application* client id (console.cloud.google.com -> Credentials).
# Authorised JavaScript origin must be the frontend origin, e.g. http://localhost:3000.
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# Signs the session cookie. Any long random string; changing it logs everyone out.
SESSION_SECRET=change-me-to-32-random-bytes
# Tokens granted to each new account on first sign-in.
FREE_TOKENS=50000
# These accounts get the /admin console (list users, top up credits).
ADMIN_EMAILS=yashwanth@stockarea.io
# Set to 0 only if your gateway rejects stream_options.include_usage; credits are then estimated.
STREAM_USAGE=1
