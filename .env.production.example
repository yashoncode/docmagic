# Hosted deployment. Copy to the backend host's environment.
#
# Two projects, same repo:
#   frontend  Root Directory "web",  Next.js,  NEXT_PUBLIC_API_URL=https://your-api...
#   backend   Root Directory ".",    Python (pyproject.toml -> api:app), everything below.
#
# Vercel can host the backend too (Fluid compute: streaming works, 500 MB bundle), but a
# long ingest can outrun the function's max duration — Render / Railway / Fly stay the
# safer home for it. Set the same variables either way.

# --- Models: hosted NVIDIA NIM, because a local router is unreachable from a cloud
# container. Keep the local router in .env for development. A free key comes from
# https://build.nvidia.com (any model page -> Get API Key).
LLM_API_KEY=nvapi-xxxx
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# Name a real model id — "auto" only works on a router gateway that supports it.
LLM_MODEL=moonshotai/kimi-k2-instruct
EMBED_API_KEY=nvapi-xxxx
EMBED_BASE_URL=https://integrate.api.nvidia.com/v1
EMBED_MODEL=nvidia/nemotron-3-embed-1b
RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2
OCR_MODEL=meta/llama-4-scout-17b-16e-instruct

# --- Storage: Supabase or Neon, with the vector extension enabled.
POSTGRES_URL=postgresql+psycopg://user:pass@host:5432/postgres

# --- Optional web search.
TAVILY_API_KEY=tvly-xxxx

# --- Cross-site cookies: the frontend is on vercel.app, this API is not, so the
# session cookie needs SameSite=None + Secure. Both hosts must be HTTPS.
WEB_ORIGIN=https://your-app.vercel.app
COOKIE_CROSS_SITE=1

# --- Sign-in and token credits. Add https://your-app.vercel.app to the OAuth client's
# authorised JavaScript origins, or Google refuses to render the button.
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
SESSION_SECRET=generate-with-python-c-import-secrets-print-secrets-token-hex-32
FREE_TOKENS=50000
ADMIN_EMAILS=yashwanth@stockarea.io
